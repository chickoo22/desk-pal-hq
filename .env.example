# ---------------------------------------------------------------------------
# DeskPal HQ — environment variables
# Copy this file to `.env` (git-ignored) and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Frontend (Vite) --------------------------------------------------------
# These are embedded in the browser bundle and are SAFE to expose publicly.
# Find them in: Supabase → Project Settings → API.

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"

# The publishable / anon key (public, protected by Row-Level Security).
VITE_SUPABASE_PUBLISHABLE_KEY="<your-anon-key>"

# Supabase project ref (the subdomain of your project URL). Optional.
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# --- End-to-end tests (Playwright) — LOCAL / CI ONLY ------------------------
# NEVER ship these to the browser. Used only by the e2e suite to seed data.

# The service_role key (SECRET — full database access, bypasses RLS).
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=""

# Base URL the e2e tests run against (defaults to http://localhost:8080).
E2E_BASE_URL="http://localhost:8080"

# Set to "1" to keep seeded test data after a run instead of tearing it down.
E2E_KEEP_DATA=""
